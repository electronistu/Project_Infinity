# Copy to `.env` and fill in. `.env` is gitignored — never commit real keys.
#
# Google AI Studio API key. Used for cached/opt-in image generation (character
# portraits, storyline scenes, sheet icons) AND to enable the Google Gemini
# entries in the Game Master model picker. Without it the Gemini models and the
# image generation toggles are disabled.
# Get one at https://aistudio.google.com/apikey and restrict it to the Gemini API.
GEMINI_API_KEY=
