      "name": "Matched Daggers (pair)",
      "description": "Twin well-balanced steel daggers with wrapped grips (1d4 piercing, Finesse, Light, Thrown (range 20/60))"
    },
    {
      "name": "Magic Dagger (+1)",
      "description": "A worn, chipped steel dagger with a leather grip gone shiny with use; cold to the touch and faintly humming. Genuinely enchanted (+1 to attack and damage rolls; counts as magical)"
    },
    {
      "name": "Silver-chased Rapier (cane-sword)",
      "description": "A fine rapier hidden in a walking cane; silver chased along the guard (1d8 piercing, Finesse)"
    },
    {
      "name": "Hand Crossbow",
      "description": "A compact crossbow taken from the Zarthus agent (1d6 piercing, Ammunition, Light, Loading, range 30/120)"
    },
    {
      "name": "Sealed Letter",
      "description": "Folded parchment, wax-sealed with a mark \u2014 a fist crushing a serpent; taken from the Zarthus agent"
    },
    {
      "name": "Dwarf's Battleaxe",
      "description": "A notched, well-used battleaxe taken from Hask (1d8 slashing, Versatile (1d10)); the haft is stamped with a small serpent-fist mark"
    },
    {
      "name": "Bronze Serpent-Fist Signet",
      "description": "A heavy bronze token bearing the fist-crushing-serpent of Zarthus \u2014 a pass, not a ring"
    },
    {
      "name": "Salted Hart Room Key",
      "description": "An iron key to Hask's rented room at the Salted Hart, riverside"
    },
    {
      "name": "Hask's Written Orders",
      "description": "A folded note in a clerk's hand \u2014 find and kill 'the High Elf who ran the east gate,' bring proof, and report to a factor who lodges at the Salted Hart"
    },
    {
      "name": "Tharrow Ledger",
      "description": "The factor's account book, listing payments and names bound for the patron at Tharrow \u2014 the key names are written in a cipher"
    },
    {
      "name": "Sealed Brass Message-Tube",
      "description": "A watertight tube holding a sealed report bound for Tharrow, meant for the first barge's manifest"
    },
    {
      "name": "Servant's Short Sword",
      "description": "A plain, well-kept short sword (1d6 piercing, Finesse, Light)"
    },
    {
      "name": "Vellin Cray's Signet Ring",
      "description": "A brass merchant's seal of Zarthus, cut with the serpent-fist \u2014 a key to certain doors, and a rope around certain necks"
    },
    {
      "name": "Factor's Hidden Slip",
      "description": "A scrap the factor kept in his boot \u2014 a berth number and the hour for the southbound barge to the Tharrow side, passage paid in advance"
    }
  ],
